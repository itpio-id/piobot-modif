{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/integrations.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/blueprint",
      "destination": "/index.html"
    },
    {
      "source": "/blueprint/",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth/callback/google",
      "destination": "/api/google/callback"
    }
  ]
}
