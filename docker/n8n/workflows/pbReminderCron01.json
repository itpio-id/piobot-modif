{
  "id": "pbReminderCron01",
  "name": "PioBot · Pengingat Kalender (tiap menit)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "nodes": [
    {
      "id": "tiap-menit",
      "name": "Tiap menit",
      "position": [
        0,
        300
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "panggil-reminders",
      "name": "Panggil /api/cron/reminders",
      "position": [
        240,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://pioassist.itpio.id/api/cron/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "pbCronSecret0001",
          "name": "PioBot CRON_SECRET (Vercel)"
        }
      }
    }
  ],
  "connections": {
    "Tiap menit": {
      "main": [
        [
          {
            "node": "Panggil /api/cron/reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
