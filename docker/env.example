# Salin ke docker/.env (gitignored) lalu isi. Nilai acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NINEROUTER_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
PIOBOT_AGENT_SECRET=
POSTGRES_PASSWORD=
PIOBOT_DB_AUTHENTICATOR_PASSWORD=
PIOBOT_DB_JWT_SECRET=
# JWT HS256 {"role":"service_role"} yang ditandatangani dengan PIOBOT_DB_JWT_SECRET
PIOBOT_DB_SERVICE_KEY=
PIOBOT_N8N_WEBHOOK_SECRET=
PIOBOT_CRON_SECRET=

# docker/.env.web (gitignored), dibaca service piobot-web:
# APP_URL=http://localhost:8765
# OWNER_EMAIL=
# INTEGRATION_SECRET=
# PIOBOT_STAFF_INITIAL_PASSWORD=   (tepat 8 karakter, wajib diganti saat login pertama)
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=
# KIE_API_KEY= / GEMINI_API_KEY= / APIFY_TOKEN= / CLICKUP_API_TOKEN=
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
